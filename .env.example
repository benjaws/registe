# Copiez ce fichier en « .env » et renseignez vos valeurs.
# Le vrai .env ne doit JAMAIS être commité ni servi publiquement.

# Clé API OpenAI (génération des thèmes d'impro)
OPENAI_API_KEY=sk-votre-cle-ici

# Ambiance : Gemini invente les lieux inconnus (facultatif ; sans clé, seuls les presets répondent).
# Clé d'un projet facturé, restreinte à l'API Gemini, avec un plafond de budget.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=10
