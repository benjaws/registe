# Copiez ce fichier en « .env » et renseignez vos valeurs.
# Le vrai .env ne doit JAMAIS être commité ni servi publiquement.

# Clé API OpenAI (génération des thèmes d'impro)
OPENAI_API_KEY=sk-votre-cle-ici

# Ambiance : modèle local Ollama qui invente les lieux inconnus (facultatif ;
# sans OLLAMA_URL, seuls les presets répondent)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=20
